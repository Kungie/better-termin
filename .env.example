# Copy to .env and fill in before publishing the site.
# Shown on /imprint and /privacy (required by § 5 DDG / § 18 MStV and the GDPR).
OPERATOR_NAME="Your Name"
# Address lines separated by |
OPERATOR_ADDRESS="Street 1|52062 Aachen|Germany"
OPERATOR_EMAIL="contact@example.com"

# Named in the privacy policy once chosen
HOSTING_PROVIDER=""
EMAIL_PROVIDER=""

# Public base URL used in e-mail links, e.g. https://better-termin.example
PUBLIC_URL=""

# E-mail delivery. Alerts stay switched off until these are set.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com and an
# app password (Google account → Security → App passwords) as SMTP_PASSWORD.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Local testing only: print e-mails to the log instead of sending them.
# DEV_MAIL_LOG=1

# Set to 1 only when the app is reachable solely through one reverse proxy.
TRUST_PROXY="0"
